@prefix : <http://purl.obolibrary.org/obo/ICO#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

obo:CHEBI_16240 a owl:Class ;
    rdfs:label "hydrogen peroxide" ;
    rdfs:comment "H2O2 — key signaling molecule for NF-κB activation. ChEBI:16240." .

obo:CHEBI_16480 a owl:Class ;
    rdfs:label "nitric oxide" ;
    rdfs:comment "NO• — vasodilation, macrophage signaling. ChEBI:16480." .

obo:CHEBI_25812 a owl:Class ;
    rdfs:label "ozone" ;
    rdfs:comment "O3 — antimicrobial, inflammatory modulator. ChEBI:25812." .

obo:CHEBI_25941 a owl:Class ;
    rdfs:label "peroxynitrite" ;
    rdfs:comment "ONOO⁻ — protein nitration, cytotoxicity. ChEBI:25941." .

obo:CHEBI_26523 a owl:Class ;
    rdfs:label "reactive oxygen species" ;
    rdfs:comment "From ChEBI. Chemical classification of ROS." .

obo:CHEBI_26689 a owl:Class ;
    rdfs:label "singlet oxygen" ;
    rdfs:comment "¹O2 — photodynamic effects. ChEBI:26689." .

obo:CHEBI_29191 a owl:Class ;
    rdfs:label "hydroxyl radical" ;
    rdfs:comment "•OH — highly reactive ROS. ChEBI:29191." .

obo:CHEBI_62764 a owl:Class ;
    rdfs:label "reactive nitrogen species" ;
    rdfs:comment "From ChEBI. Chemical classification of RNS." .

obo:GO_0000302 a owl:Class ;
    rdfs:label "response to reactive oxygen species" ;
    rdfs:comment "From Gene Ontology. Directly relevant to RONS-immune axis." .

obo:GO_0006954 a owl:Class ;
    rdfs:label "inflammatory response" ;
    rdfs:comment "From Gene Ontology." .

obo:GO_0006955 a owl:Class ;
    rdfs:label "immune response" ;
    rdfs:comment "From Gene Ontology. Biological process of immune system activation." .

obo:IAO_0000114 a owl:AnnotationProperty ;
    rdfs:label "curation status" .

obo:IAO_0000115 a owl:AnnotationProperty ;
    rdfs:label "definition" .

obo:ICO a owl:Ontology ;
    dc:contributor "KIMS (Korea Institute of Materials Science)" ;
    dc:creator "Seunghoon Lee" ;
    dc:description "A multi-dimensional ontology integrating environmental, lifelog, and biomarker data for immune disease trajectory prediction and plasma medicine-based treatment."@en ;
    dc:rights "CC-BY 4.0" ;
    dc:title "Immune Care Ontology"@en,
        "면역 케어 온톨로지"@ko ;
    rdfs:comment "MIREOT: environmental material and atmospheric feature classes from ENVO",
        "MIREOT: exposure event, stressor, route classes from Exposure Ontology",
        "MIREOT: obo:CHEBI_26523 (ROS), obo:CHEBI_62764 (RNS) subtrees from ChEBI",
        "MIREOT: obo:DOID_2914 (immune system disease) subtree from Disease Ontology",
        "MIREOT: obo:GO_0006955 (immune response), obo:GO_0000302 (response to ROS) from Gene Ontology" ;
    owl:imports obo:bfo.owl ;
    owl:versionIRI <http://purl.obolibrary.org/obo/ICO/2026-03-30/ico.owl> ;
    owl:versionInfo "0.2.0" .

:AM_Stage1_AD a :TrajectoryStage,
        owl:NamedIndividual ;
    rdfs:label "Allergic March Stage 1: Atopic Dermatitis (L20)" ;
    :precedes :AM_Stage2_Asthma .

:AllergenExposureScore a owl:Class ;
    rdfs:label "Allergen Exposure Score" ;
    obo:IAO_0000115 "Composite of humidity + mold + dust mite exposure." ;
    :koreanLabel "알레르겐 노출점수" ;
    rdfs:subClassOf :CompositeEnvironmentalIndex .

:AllergicMarch_Trajectory a :AllergicMarch,
        owl:NamedIndividual ;
    rdfs:label "Standard Allergic March Progression" ;
    obo:IAO_0000115 "AD(L20) → Asthma(J45) → AR(J30) → Psoriasis(L40) → Dry Eye(H04.1). Composite prediction r=+0.62, target AUC ≥ 0.85." ;
    :koreanLabel "표준 알레르기 마치 진행" .

:AllergicRhinitis a owl:Class ;
    rdfs:label "Allergic Rhinitis" ;
    obo:IAO_0000115 "ICD-10: J30. Part of allergic march trajectory." ;
    :koreanLabel "알레르기 비염" ;
    rdfs:subClassOf :ImmuneDisease .

:Alopecia a owl:Class ;
    rdfs:label "Alopecia" ;
    obo:IAO_0000115 "Immune-mediated hair loss. Plasma treatment has shown hair regrowth potential." ;
    :koreanLabel "탈모" ;
    rdfs:subClassOf :ImmuneDisease .

:BTEX a owl:Class ;
    rdfs:label "BTEX" ;
    obo:IAO_0000115 "Benzene, Toluene, Ethylbenzene, and Xylene — immunotoxic aromatic hydrocarbons." ;
    :koreanLabel "벤젠/톨루엔/에틸벤젠/자일렌" ;
    rdfs:subClassOf :VolatileOrganicCompound .

:CAP_NFkB_Inhibition_Path a :CausalPathway,
        owl:NamedIndividual ;
    rdfs:label "CAP NO → S-nitrosylation → NF-κB inhibition" ;
    obo:IAO_0000115 "Plasma NO at low dose → S-nitrosylation of NF-κB → anti-inflammatory effect → IL-6 decrease." ;
    :hasEvidenceStrength "Planned" ;
    :hasSourceFactor :NitricOxide ;
    :hasSourceLayer "L4" ;
    :hasTargetFactor :IL6 ;
    :hasTargetLayer "L3" ;
    :involvesPathway :NFkBPathway .

:CAP_Nrf2_Activation_Path a :CausalPathway,
        owl:NamedIndividual ;
    rdfs:label "CAP low-dose ROS → Nrf2 → antioxidant defense" ;
    obo:IAO_0000115 "RONS hormesis → Keap1 oxidation → Nrf2 nuclear translocation → ARE activation → HO-1/SOD/catalase upregulation." ;
    :hasEvidenceStrength "Planned" ;
    :hasSourceLayer "L4" ;
    :hasTargetLayer "L3" ;
    :involvesPathway :Nrf2Keap1Pathway .

:CAP_Psoriasis_Treatment_Path a :CausalPathway,
        owl:NamedIndividual ;
    rdfs:label "CAP Patch (630ns) → Th17/TNF-α modulation → Psoriasis treatment" ;
    obo:IAO_0000115 "CAP patch → selective RONS → Th17/TNF-α axis modulation → psoriasis plaque reduction. Published: Adv Sci 2022, IF 14.3." ;
    :hasEvidenceStrength "Published" ;
    :hasSourceFactor :CAPPatch ;
    :hasSourceLayer "L4" ;
    :hasTargetFactor :Psoriasis ;
    :hasTargetLayer "Disease" ;
    :involvesPathway :Th17Pathway .

:CO2Level a owl:Class ;
    rdfs:label "CO2 Level" ;
    obo:IAO_0000115 "Indoor CO2 concentration as a proxy for ventilation quality." ;
    :koreanLabel "이산화탄소 농도" ;
    rdfs:subClassOf :EnvironmentalFactor .

:CompositeScore_to_AllergicMarch_Path a :CausalPathway,
        owl:NamedIndividual ;
    rdfs:label "Multi-layer composite → Allergic March trajectory" ;
    obo:IAO_0000115 "Multi-layer fusion: Env + Lifelog + Biomarker → disease trajectory. Target AUC ≥ 0.85." ;
    :hasCorrelationCoefficient "0.62"^^xsd:float ;
    :hasEvidenceStrength "Target" ;
    :hasLagTime "17520.0"^^xsd:float ;
    :hasSourceLayer "L1+L2+L3" ;
    :hasTargetFactor :AllergicMarch ;
    :hasTargetLayer "Disease" .

:DryEyeDisease a owl:Class ;
    rdfs:label "Dry Eye Disease" ;
    obo:IAO_0000115 "ICD-10: H04.1. Inflammatory component in immune-mediated dry eye." ;
    :koreanLabel "안구건조증" ;
    rdfs:subClassOf :ImmuneDisease .

:DustMite a owl:Class ;
    rdfs:label "Dust Mite" ;
    obo:IAO_0000115 "House dust mites producing Der p1 antigen that triggers IL-13 via Th2 pathway." ;
    :koreanLabel "진드기" ;
    rdfs:subClassOf :BiologicalAllergen .

:ELISA a owl:Class ;
    rdfs:label "ELISA" ;
    obo:IAO_0000115 "Enzyme-linked immunosorbent assay for cytokine quantification." ;
    rdfs:subClassOf :BiomarkerAssay .

:EPRSpectroscopy a owl:Class ;
    rdfs:label "EPR Spectroscopy" ;
    obo:IAO_0000115 "Electron Paramagnetic Resonance spectroscopy for RONS selectivity ratio evaluation." ;
    rdfs:subClassOf :RONSMeasurement .

:EnvironmentalSensor a owl:Class ;
    rdfs:label "Environmental Sensor" ;
    obo:IAO_0000115 "IoT sensor device for measuring environmental parameters." ;
    :koreanLabel "환경 센서" .

:Formaldehyde a owl:Class ;
    rdfs:label "Formaldehyde" ;
    :koreanLabel "포름알데히드" ;
    rdfs:subClassOf :VolatileOrganicCompound .

:HRV_to_IL6_Path a :CausalPathway,
        owl:NamedIndividual ;
    rdfs:label "Low HRV → weakened vagal reflex → IL-6 increase" ;
    obo:IAO_0000115 "Low vagal tone → cholinergic anti-inflammatory reflex weakened → IL-6 upregulation." ;
    :hasCorrelationCoefficient "-0.42"^^xsd:float ;
    :hasEvidenceStrength "Strong" ;
    :hasLagTime "6.0"^^xsd:float ;
    :hasSourceFactor :HRVMeasurement ;
    :hasSourceLayer "L2" ;
    :hasTargetFactor :IL6 ;
    :hasTargetLayer "L3" .

:HormesisResponse a owl:Class ;
    rdfs:label "Hormesis Response" ;
    obo:IAO_0000115 "Beneficial adaptive biological response to low-dose RONS stress from plasma exposure. Low-dose stimulates; high-dose inhibits." ;
    :koreanLabel "호르메시스 반응" .

:HydroxylRadical a owl:Class ;
    rdfs:label "Hydroxyl Radical" ;
    obo:IAO_0000115 "•OH — highly reactive ROS. ChEBI:29191." ;
    :koreanLabel "하이드록실 라디칼" ;
    rdfs:subClassOf :ReactiveOxygenSpecies .

:IL10 a owl:Class ;
    rdfs:label "Interleukin-10" ;
    :koreanLabel "인터류킨-10" ;
    rdfs:subClassOf :AntiInflammatoryCytokine .

:IL17 a owl:Class ;
    rdfs:label "Interleukin-17" ;
    obo:IAO_0000115 "Th17 pathway cytokine. TNF-α + IL-17 correlates with psoriasis (r=+0.50)." ;
    :koreanLabel "인터류킨-17" ;
    rdfs:subClassOf :ProInflammatoryCytokine .

:IL4 a owl:Class ;
    rdfs:label "Interleukin-4" ;
    obo:IAO_0000115 "Th2 cytokine involved in Th1/Th2 balance regulation and IgE class switching." ;
    :koreanLabel "인터류킨-4" ;
    rdfs:subClassOf :AntiInflammatoryCytokine .

:IL4_IL13_to_AtopicDerm_Path a :CausalPathway,
        owl:NamedIndividual ;
    rdfs:label "IL-4/IL-13 high → filaggrin loss → Atopic Dermatitis" ;
    obo:IAO_0000115 "Th2 cytokine → filaggrin downregulation → barrier dysfunction → AD flare." ;
    :hasCorrelationCoefficient "0.58"^^xsd:float ;
    :hasEvidenceStrength "Strong" ;
    :hasLagTime "336.0"^^xsd:float ;
    :hasSourceFactor :IL13 ;
    :hasSourceLayer "L3" ;
    :hasTargetFactor :AtopicDermatitis ;
    :hasTargetLayer "Disease" .

:IL5 a owl:Class ;
    rdfs:label "Interleukin-5" ;
    obo:IAO_0000115 "Eosinophil recruitment cytokine. IgE + IL-5 correlates with asthma onset (r=+0.55)." ;
    :koreanLabel "인터류킨-5" ;
    rdfs:subClassOf :ProInflammatoryCytokine .

:IgE_IL5_to_Asthma_Path a :CausalPathway,
        owl:NamedIndividual ;
    rdfs:label "IgE + IL-5 → eosinophil → Asthma" ;
    obo:IAO_0000115 "IgE sensitization → eosinophil recruitment (IL-5) → airway hyperreactivity → asthma." ;
    :hasCorrelationCoefficient "0.55"^^xsd:float ;
    :hasEvidenceStrength "Strong" ;
    :hasLagTime "2160.0"^^xsd:float ;
    :hasSourceFactor :IgE ;
    :hasSourceLayer "L3" ;
    :hasTargetFactor :Asthma ;
    :hasTargetLayer "Disease" .

:ImmuneRiskScore a owl:Class ;
    rdfs:label "Immune Risk Score" ;
    obo:IAO_0000115 "A composite score derived from multi-layer data (environment + lifelog + biomarker) predicting immune disease risk." ;
    :koreanLabel "면역 위험 점수" .

:LowActivity_to_TNFa_Path a :CausalPathway,
        owl:NamedIndividual ;
    rdfs:label "Low activity → adipokine → TNF-α elevation" ;
    obo:IAO_0000115 "Sedentary → adipose tissue expansion → adipokine-mediated TNF-α." ;
    :hasCorrelationCoefficient "0.28"^^xsd:float ;
    :hasEvidenceStrength "Emerging" ;
    :hasLagTime "72.0"^^xsd:float ;
    :hasSourceFactor :PhysicalActivityLevel ;
    :hasSourceLayer "L2" ;
    :hasTargetFactor :TNFAlpha ;
    :hasTargetLayer "L3" .

:MDA a owl:Class ;
    rdfs:label "Malondialdehyde" ;
    obo:IAO_0000115 "Lipid peroxidation marker indicating oxidative stress." ;
    :koreanLabel "말론디알데히드" ;
    rdfs:subClassOf :OxidativeDamageMarker .

:Mold a owl:Class ;
    rdfs:label "Mold" ;
    :koreanLabel "곰팡이" ;
    rdfs:subClassOf :BiologicalAllergen .

:NLRP3Inflammasome a owl:Class ;
    rdfs:label "NLRP3 Inflammasome" ;
    obo:IAO_0000115 "Innate immune inflammatory complex activated by environmental stress signals." ;
    :koreanLabel "NLRP3 인플라마좀" ;
    rdfs:subClassOf :SignalingPathway .

:NanosecondPulseControl a owl:Class ;
    rdfs:label "Nanosecond Pulse Control" ;
    obo:IAO_0000115 "Key technology for selective RONS generation via nanosecond-scale pulse power control (demonstrated at 630 ns, ~3 kV peak)." ;
    :koreanLabel "나노초 펄스 제어" ;
    rdfs:subClassOf :PlasmaOperatingParameters .

:NitrogenDioxide a owl:Class ;
    rdfs:label "Nitrogen Dioxide" ;
    obo:IAO_0000115 "NO2• — oxidative stress inducer. ChEBI:33101." ;
    :koreanLabel "이산화질소" ;
