:OxidativeStressLoad a owl:Class ;
    rdfs:label "Oxidative Stress Load" ;
    obo:IAO_0000115 "Composite of PM + VOC + O3 representing total oxidative burden from environmental exposure." ;
    :koreanLabel "산화스트레스 부하" ;
    rdfs:subClassOf :CompositeEnvironmentalIndex .

:Ozone a owl:Class ;
    rdfs:label "Ozone (Environmental)" ;
    :koreanLabel "오존 (환경)" ;
    rdfs:subClassOf :AirPollutant .

:PFAS a owl:Class ;
    rdfs:label "PFAS" ;
    obo:IAO_0000115 "Per- and polyfluoroalkyl substances — persistent environmental contaminants that disrupt immune function." ;
    :koreanLabel "과불화화합물" ;
    rdfs:subClassOf :EnvironmentalFactor .

:PM10 a owl:Class ;
    rdfs:label "PM10" ;
    :koreanLabel "미세먼지" ;
    rdfs:subClassOf :ParticulateMatter .

:PM2_5_to_8OHdG_Path a :CausalPathway,
        owl:NamedIndividual ;
    rdfs:label "PM2.5 → mitochondrial ROS → 8-OHdG" ;
    obo:IAO_0000115 "PM2.5 → mitochondrial ROS → DNA oxidative damage via 8-OHdG." ;
    :hasCorrelationCoefficient "0.48"^^xsd:float ;
    :hasEvidenceStrength "Strong" ;
    :hasLagTime "48.0"^^xsd:float ;
    :hasSourceFactor :PM2_5 ;
    :hasSourceLayer "L1" ;
    :hasTargetFactor :OHdG_8 ;
    :hasTargetLayer "L3" .

:PM2_5_to_CRP_Path a :CausalPathway,
        owl:NamedIndividual ;
    rdfs:label "PM2.5 → systemic inflammation → CRP" ;
    obo:IAO_0000115 "PM2.5 → systemic inflammation spillover → hepatic CRP synthesis." ;
    :hasCorrelationCoefficient "0.38"^^xsd:float ;
    :hasEvidenceStrength "Strong" ;
    :hasLagTime "60.0"^^xsd:float ;
    :hasSourceFactor :PM2_5 ;
    :hasSourceLayer "L1" ;
    :hasTargetFactor :CRP ;
    :hasTargetLayer "L3" ;
    :involvesPathway :NFkBPathway .

:PM2_5_to_HRV_Path a :CausalPathway,
        owl:NamedIndividual ;
    rdfs:label "PM2.5 → autonomic imbalance → HRV decrease" ;
    obo:IAO_0000115 "PM2.5 → autonomic imbalance → vagal tone decrease → SDNN drop." ;
    :hasCorrelationCoefficient "-0.42"^^xsd:float ;
    :hasEvidenceStrength "Strong" ;
    :hasLagTime "4.0"^^xsd:float ;
    :hasSourceFactor :PM2_5 ;
    :hasSourceLayer "L1" ;
    :hasTargetFactor :HRVMeasurement ;
    :hasTargetLayer "L2" .

:PM2_5_to_IL6_Path a :CausalPathway,
        owl:NamedIndividual ;
    rdfs:label "PM2.5 → NF-κB → IL-6" ;
    obo:IAO_0000115 "PM2.5 → ROS generation → NF-κB activation → IL-6 transcription." ;
    :hasCorrelationCoefficient "0.52"^^xsd:float ;
    :hasEvidenceStrength "Strong" ;
    :hasLagTime "15.0"^^xsd:float ;
    :hasSourceFactor :PM2_5 ;
    :hasSourceLayer "L1" ;
    :hasTargetFactor :IL6 ;
    :hasTargetLayer "L3" ;
    :involvesPathway :NFkBPathway ;
    :koreanLabel "PM2.5 → NF-κB → IL-6 경로" .

:PM2_5_to_SpO2_Path a :CausalPathway,
        owl:NamedIndividual ;
    rdfs:label "PM2.5 → airway inflammation → SpO2 decrease" ;
    obo:IAO_0000115 "PM2.5 → airway inflammation → V/Q mismatch → SpO2 decrease." ;
    :hasCorrelationCoefficient "-0.25"^^xsd:float ;
    :hasEvidenceStrength "Moderate" ;
    :hasLagTime "4.0"^^xsd:float ;
    :hasSourceFactor :PM2_5 ;
    :hasSourceLayer "L1" ;
    :hasTargetFactor :SpO2Measurement ;
    :hasTargetLayer "L2" .

:PM2_5_to_TNFa_Path a :CausalPathway,
        owl:NamedIndividual ;
    rdfs:label "PM2.5 → M1 macrophage → TNF-α" ;
    obo:IAO_0000115 "PM2.5 → alveolar macrophage M1 polarization → TNF-α release." ;
    :hasCorrelationCoefficient "0.45"^^xsd:float ;
    :hasEvidenceStrength "Strong" ;
    :hasLagTime "15.0"^^xsd:float ;
    :hasSourceFactor :PM2_5 ;
    :hasSourceLayer "L1" ;
    :hasTargetFactor :TNFAlpha ;
    :hasTargetLayer "L3" ;
    :involvesPathway :NFkBPathway ;
    :koreanLabel "PM2.5 → M1 대식세포 → TNF-α 경로" .

:PlasmaOzone a owl:Class ;
    rdfs:label "Ozone (Plasma-generated)" ;
    obo:IAO_0000115 "O3 generated by plasma device. ChEBI:25812." ;
    :koreanLabel "오존 (플라즈마 생성)" ;
    rdfs:subClassOf :ReactiveOxygenSpecies .

:PortablePlasmaGenerator a owl:Class ;
