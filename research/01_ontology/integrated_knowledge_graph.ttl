    :hasCorrelationCoefficient "0.3"^^xsd:float ;
    :hasEvidenceStrength "Moderate" ;
    :hasLagTime "72.0"^^xsd:float ;
    :hasSourceFactor :RelativeHumidity ;
    :hasSourceLayer "L1" ;
    :hasTargetFactor :IL13 ;
    :hasTargetLayer "L3" .

:RONSSelectivityProfile a owl:Class ;
    rdfs:label "RONS Selectivity Profile" ;
    obo:IAO_0000115 "The ratio and composition of RONS species generated by a specific plasma parameter set. Target selectivity ratio ≥ 10." ;
    :koreanLabel "RONS 선택성 프로필" .

:Radon a owl:Class ;
    rdfs:label "Radon" ;
    obo:IAO_0000115 "Radioactive gas contributing to immune suppression." ;
