:VOCs_to_Sleep_Path a :CausalPathway,
        owl:NamedIndividual ;
    rdfs:label "VOCs → airway irritation → sleep disruption" ;
    obo:IAO_0000115 "VOCs → upper airway irritation → sleep fragmentation → deep sleep decrease." ;
    :hasCorrelationCoefficient "-0.32"^^xsd:float ;
    :hasEvidenceStrength "Moderate" ;
    :hasLagTime "6.0"^^xsd:float ;
    :hasSourceFactor :VolatileOrganicCompound ;
    :hasSourceLayer "L1" ;
    :hasTargetFactor :SleepQualityAssessment ;
    :hasTargetLayer "L2" .

:VentilationIndex a owl:Class ;
    rdfs:label "Ventilation Index" ;
    obo:IAO_0000115 "CO2 decay rate as a proxy for indoor ventilation quality." ;
    :koreanLabel "환기지수" ;
    rdfs:subClassOf :CompositeEnvironmentalIndex .

:WearableDevice a owl:Class ;
    rdfs:label "Wearable Device" ;
    obo:IAO_0000115 "Personal wearable sensor for continuous biosignal monitoring (smartwatch, smart ring, skin-attachable sensor)." ;
    :koreanLabel "웨어러블 기기" .

:activatesPathway a owl:ObjectProperty ;
    rdfs:label "activates pathway" ;
    obo:IAO_0000115 "Relates a reactive species or environmental exposure to a signaling pathway it activates." .

:correlatesWith a owl:ObjectProperty ;
    rdfs:label "correlates with" ;
    obo:IAO_0000115 "Statistical correlation between measurements across layers." .

:hasAUCScore a owl:DatatypeProperty ;
    rdfs:label "has AUC score" ;
    rdfs:range xsd:float .

:hasBiomarkerLevel a owl:ObjectProperty ;
    rdfs:label "has biomarker level" ;
    obo:IAO_0000115 "Relates a patient observation to a measured biomarker value." .

:hasCorrelationCoefficient a owl:DatatypeProperty ;
    rdfs:label "has correlation coefficient" ;
    rdfs:range xsd:float .

:hasEvidenceStrength a owl:DatatypeProperty ;
    rdfs:label "has evidence strength" ;
    obo:IAO_0000115 "Evidence level: Strong, Moderate, Emerging, Planned, Published." ;
    rdfs:range xsd:string .

:hasExposureTo a owl:ObjectProperty ;
    rdfs:label "has exposure to" ;
    obo:IAO_0000115 "Relates a subject to an environmental stressor they are exposed to." ;
    rdfs:domain :Patient ;
    rdfs:range :EnvironmentalFactor .

:hasLagTime a owl:DatatypeProperty ;
    rdfs:label "has lag time" ;
    obo:IAO_0000115 "Time delay between cause and effect in hours." ;
    rdfs:range xsd:float .

:hasLifelogObservation a owl:ObjectProperty ;
    rdfs:label "has lifelog observation" ;
    rdfs:domain :Patient ;
    rdfs:range :LifelogObservation .

:hasSelectivityRatio a owl:DatatypeProperty ;
    rdfs:label "has selectivity ratio" ;
    obo:IAO_0000115 "Ratio of desired to undesired RONS species generated by plasma device." ;
    rdfs:range xsd:float .

:hasSourceFactor a owl:ObjectProperty ;
    rdfs:label "has source factor" ;
    obo:IAO_0000115 "The originating factor (cause) in a causal pathway." ;
    rdfs:domain :CausalPathway .

:hasSourceLayer a owl:DatatypeProperty ;
    rdfs:label "has source layer" ;
    obo:IAO_0000115 "The originating layer (L1=Environment, L2=Lifelog, L3=Biomarker, L4=Plasma)." ;
    rdfs:range xsd:string .

:hasTargetFactor a owl:ObjectProperty ;
    rdfs:label "has target factor" ;
    obo:IAO_0000115 "The resulting factor (effect) in a causal pathway." ;
    rdfs:domain :CausalPathway .

:hasTargetLayer a owl:DatatypeProperty ;
    rdfs:label "has target layer" ;
    obo:IAO_0000115 "The target layer (L2=Lifelog, L3=Biomarker, Disease)." ;
    rdfs:range xsd:string .

:hasTimestamp a owl:DatatypeProperty ;
    rdfs:label "has timestamp" ;
    rdfs:range xsd:dateTime .

:hasTrajectoryStage a owl:ObjectProperty ;
    rdfs:label "has trajectory stage" ;
    obo:IAO_0000115 "Relates a disease trajectory to its component stages." ;
    rdfs:domain :DiseaseTrajectory ;
    rdfs:range :TrajectoryStage .

:hasUnit a owl:DatatypeProperty ;
    rdfs:label "has unit" ;
    rdfs:range xsd:string .

:hasValue a owl:DatatypeProperty ;
    rdfs:label "has value" ;
    rdfs:range xsd:float .

:inducesRONS a owl:ObjectProperty ;
    rdfs:label "induces RONS" ;
    obo:IAO_0000115 "Relates a plasma device operation to the reactive species it generates." ;
    rdfs:domain :PlasmaExposureEvent ;
    rdfs:range :ReactiveSpecies .

:involvesPathway a owl:ObjectProperty ;
    rdfs:label "involves pathway" ;
    obo:IAO_0000115 "The signaling pathway mediating a causal relationship." ;
    rdfs:domain :CausalPathway ;
    rdfs:range :SignalingPathway .

:koreanLabel a owl:AnnotationProperty ;
    rdfs:label "Korean label" .

:measuredBy a owl:ObjectProperty ;
    rdfs:label "measured by" ;
    obo:IAO_0000115 "Relates a biomarker to the assay or device used to measure it." .

:modulatesImmune a owl:ObjectProperty ;
    rdfs:label "modulates immune response" ;
    obo:IAO_0000115 "Relates a signaling pathway activation to its effect on immune function." .

:precedes a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "precedes" ;
    obo:IAO_0000115 "Temporal ordering of trajectory stages." ;
    rdfs:domain :TrajectoryStage ;
    rdfs:range :TrajectoryStage .

:treatedBy a owl:ObjectProperty ;
    rdfs:label "treated by" ;
    obo:IAO_0000115 "Relates an immune disease to a plasma treatment protocol." ;
    rdfs:domain :ImmuneDisease ;
    rdfs:range :TreatmentProtocol .

obo:BFO_0000016 a owl:Class ;
    rdfs:label "disposition" .

obo:BFO_0000020 a owl:Class ;
    rdfs:label "specifically dependent continuant" .

obo:DOID_2914 a owl:Class ;
    rdfs:label "immune system disease" ;
    rdfs:comment "From Disease Ontology. Root class for all immune diseases." .

:AM_Stage2_Asthma a :TrajectoryStage,
        owl:NamedIndividual ;
    rdfs:label "Allergic March Stage 2: Asthma (J45)" ;
    :precedes :AM_Stage3_AR .

:AM_Stage3_AR a :TrajectoryStage,
        owl:NamedIndividual ;
    rdfs:label "Allergic March Stage 3: Allergic Rhinitis (J30)" ;
    :precedes :AM_Stage4_Psoriasis .

:AM_Stage4_Psoriasis a :TrajectoryStage,
        owl:NamedIndividual ;
    rdfs:label "Allergic March Stage 4: Psoriasis (L40)" ;
    :precedes :AM_Stage5_DryEye .

:AM_Stage5_DryEye a :TrajectoryStage,
        owl:NamedIndividual ;
    rdfs:label "Allergic March Stage 5: Dry Eye Disease (H04.1)" .

:Asthma a owl:Class ;
    rdfs:label "Asthma" ;
    obo:IAO_0000115 "ICD-10: J45. IgE sensitization → eosinophil recruitment (IL-5) → airway hyperreactivity. IgE+IL-5 correlates r=+0.55." ;
    :koreanLabel "천식" ;
    rdfs:subClassOf :ImmuneDisease .

:AtopicDermatitis a owl:Class ;
    rdfs:label "Atopic Dermatitis" ;
    obo:IAO_0000115 "ICD-10: L20. Driven by Th2 cytokines (IL-4/IL-13) → filaggrin downregulation → barrier dysfunction. IL-4/IL-13 high correlates r=+0.58." ;
    :koreanLabel "아토피 피부염" ;
    rdfs:subClassOf :ImmuneDisease .

:CAPPatch a owl:Class ;
    rdfs:label "CAP Patch" ;
    obo:IAO_0000115 "Wearable skin-contact cold atmospheric plasma patch. World-first patent (PI). Published in Advanced Science (IF 14.3, 2022) for psoriasis treatment." ;
    :koreanLabel "CAP 패치" ;
    rdfs:subClassOf :ColdAtmosphericPlasmaDevice .

:NitricOxide a owl:Class ;
    rdfs:label "Nitric Oxide" ;
    obo:IAO_0000115 "NO• — vasodilation, macrophage signaling, iNOS product. ChEBI:16480." ;
    :koreanLabel "일산화질소" ;
    rdfs:subClassOf :ReactiveNitrogenSpecies .

:Nrf2Keap1Pathway a owl:Class ;
    rdfs:label "Nrf2/Keap1 Pathway" ;
    obo:IAO_0000115 "Cytoprotective/anti-inflammatory pathway. RONS → Keap1 oxidation → Nrf2 → ARE activation → antioxidant enzyme upregulation (HO-1, SOD, catalase)." ;
    :koreanLabel "Nrf2/Keap1 경로" ;
    rdfs:subClassOf :SignalingPathway .

:OHdG_8 a owl:Class ;
    rdfs:label "8-OHdG" ;
    obo:IAO_0000115 "DNA oxidative damage marker. PM2.5 → mitochondrial ROS → DNA oxidative damage (r=+0.48, lag 24-72h)." ;
    :koreanLabel "8-하이드록시디옥시구아노신" ;
    rdfs:subClassOf :OxidativeDamageMarker .

:PhysicalActivityLevel a owl:Class ;
    rdfs:label "Physical Activity Level" ;
    obo:IAO_0000115 "Steps, METs, and activity classification. Low activity correlates with elevated TNF-α via adipokine pathway (r=-0.28)." ;
    :koreanLabel "신체활동수준" ;
    rdfs:subClassOf :LifelogObservation .

:PlasmaExposureEvent a owl:Class ;
    rdfs:label "Plasma Exposure Event" ;
    obo:IAO_0000115 "A single instance of cold atmospheric plasma treatment application to a patient or biological target." ;
    :koreanLabel "플라즈마 노출 사건" ;
    rdfs:subClassOf obo:BFO_0000015 .

:PlasmaOperatingParameters a owl:Class ;
    rdfs:label "Plasma Operating Parameters" ;
    obo:IAO_0000115 "Physical parameters controlling plasma generation: pulse width, voltage, frequency, gas composition, exposure duration, distance." ;
    :koreanLabel "플라즈마 작동 파라미터" .

:RelativeHumidity a owl:Class ;
    rdfs:label "Relative Humidity" ;
    :koreanLabel "상대습도" ;
    rdfs:subClassOf :ClimateFactor .

:SpO2Measurement a owl:Class ;
    rdfs:label "SpO2 Measurement" ;
    obo:IAO_0000115 "Peripheral oxygen saturation measurement. Correlates with CRP (r=-0.35)." ;
    :koreanLabel "산소포화도 측정" ;
    rdfs:subClassOf :LifelogObservation .

:SystemicInflammationMarker a owl:Class ;
    rdfs:label "Systemic Inflammation Marker" ;
    :koreanLabel "전신 염증 마커" ;
    rdfs:subClassOf :Biomarker .

:Th1Th2Balance a owl:Class ;
    rdfs:label "Th1/Th2 Balance" ;
    obo:IAO_0000115 "Adaptive immune polarization between Th1 (cellular) and Th2 (humoral/allergic) responses." ;
    :koreanLabel "Th1/Th2 균형" ;
    rdfs:subClassOf :SignalingPathway .

:TreatmentProtocol a owl:Class ;
    rdfs:label "Treatment Protocol" ;
    obo:IAO_0000115 "Disease-customized plasma treatment plan specifying device type, RONS cocktail, duration, frequency, and target pathway." ;
    :koreanLabel "치료 프로토콜" .

:AllergicMarch a owl:Class ;
    rdfs:label "Allergic March" ;
    obo:IAO_0000115 "The progressive sequence: Atopic Dermatitis (L20) → Asthma (J45) → Allergic Rhinitis (J30) → Psoriasis (L40) → Dry Eye (H04.1). Composite prediction AUC target ≥ 0.85." ;
    :koreanLabel "알레르기 마치" ;
    rdfs:subClassOf :DiseaseTrajectory .

:BiologicalAllergen a owl:Class ;
    rdfs:label "Biological Allergen" ;
    :koreanLabel "생물학적 알레르겐" ;
    rdfs:subClassOf :EnvironmentalFactor .

:BiomarkerAssay a owl:Class ;
    rdfs:label "Biomarker Assay" ;
    :koreanLabel "바이오마커 분석법" .

:CRP a owl:Class ;
    rdfs:label "C-Reactive Protein" ;
    obo:IAO_0000115 "Acute-phase protein produced by hepatocytes. PM2.5 → systemic inflammation → hepatic CRP synthesis (r=+0.38, lag 48-72h)." ;
    :koreanLabel "C반응단백" ;
    rdfs:subClassOf :SystemicInflammationMarker .

:ClimateFactor a owl:Class ;
    rdfs:label "Climate Factor" ;
    :koreanLabel "기후 요인" ;
    rdfs:subClassOf :EnvironmentalFactor .

:ColdAtmosphericPlasmaDevice a owl:Class ;
    rdfs:label "Cold Atmospheric Plasma Device" ;
    obo:IAO_0000115 "A device generating non-thermal plasma at atmospheric pressure for biomedical applications. Includes CAP patches, portable generators, and porous ceramic dielectric devices." ;
    :koreanLabel "저온 대기압 플라즈마 기기" ;
    rdfs:subClassOf obo:BFO_0000004 .

:Cytokine a owl:Class ;
    rdfs:label "Cytokine" ;
    :koreanLabel "사이토카인" ;
    rdfs:subClassOf :Biomarker .

:HRVMeasurement a owl:Class ;
    rdfs:label "Heart Rate Variability Measurement" ;
    obo:IAO_0000115 "Measurement of autonomic nervous system tone via R-R interval variability. Low HRV (SDNN) correlates with weakened vagal anti-inflammatory reflex and elevated IL-6 (r=-0.42, lag 2-6h)." ;
    :koreanLabel "심박변이도 측정" ;
    rdfs:subClassOf :LifelogObservation .

:IL13 a owl:Class ;
    rdfs:label "Interleukin-13" ;
    obo:IAO_0000115 "Th2 cytokine. High humidity → dust mite → Der p1 → IL-13 pathway. IL-4/IL-13 high correlates with atopic dermatitis (r=+0.58)." ;
    :koreanLabel "인터류킨-13" ;
    rdfs:subClassOf :AntiInflammatoryCytokine .

:IgE a owl:Class ;
    rdfs:label "Immunoglobulin E" ;
    obo:IAO_0000115 "Allergy antibody. VOCs → epithelial barrier disruption → Th2 skew → IgE class switch." ;
    :koreanLabel "면역글로불린 E" ;
    rdfs:subClassOf :Biomarker .

:OxidativeDamageMarker a owl:Class ;
    rdfs:label "Oxidative Damage Marker" ;
    :koreanLabel "산화 손상 마커" ;
    rdfs:subClassOf :Biomarker .

:ParticulateMatter a owl:Class ;
    rdfs:label "Particulate Matter" ;
    obo:IAO_0000115 "Airborne particles including PM2.5 and PM10 that trigger ROS generation and NF-κB pathway activation." ;
    :koreanLabel "미세먼지" ;
    rdfs:subClassOf :AirPollutant .

:Patient a owl:Class ;
    rdfs:label "Patient" ;
    obo:IAO_0000115 "A human individual whose immune status is being monitored and/or treated." ;
    :koreanLabel "환자" ;
    rdfs:subClassOf obo:BFO_0000004 .

:Psoriasis a owl:Class ;
    rdfs:label "Psoriasis" ;
    obo:IAO_0000115 "ICD-10: L40. Th17/TNF-α axis → keratinocyte hyperproliferation → plaque formation. TNF-α+IL-17 correlates r=+0.50." ;
    :koreanLabel "건선" ;
    rdfs:subClassOf :ImmuneDisease .

:RONSMeasurement a owl:Class ;
    rdfs:label "RONS Measurement" ;
    :koreanLabel "RONS 측정" .

:ReactiveNitrogenSpecies a owl:Class ;
    rdfs:label "Reactive Nitrogen Species" ;
    :koreanLabel "활성질소종" ;
    rdfs:subClassOf :ReactiveSpecies .

:SleepQualityAssessment a owl:Class ;
    rdfs:label "Sleep Quality Assessment" ;
    obo:IAO_0000115 "Deep/REM sleep ratio assessment. Sleep deprivation activates HPA axis, elevating cortisol and CRP (r=-0.38 with TNF-α)." ;
    :koreanLabel "수면 질 평가" ;
    rdfs:subClassOf :LifelogObservation .

:Th17Pathway a owl:Class ;
    rdfs:label "Th17 Pathway" ;
    obo:IAO_0000115 "IL-17-producing T helper cell pathway. Th17/TNF-α axis drives psoriasis via keratinocyte hyperproliferation." ;
    :koreanLabel "Th17 경로" ;
    rdfs:subClassOf :SignalingPathway .

:AirPollutant a owl:Class ;
    rdfs:label "Air Pollutant" ;
    :koreanLabel "대기 오염물질" ;
    rdfs:subClassOf :EnvironmentalFactor .

:AntiInflammatoryCytokine a owl:Class ;
    rdfs:label "Anti-inflammatory Cytokine" ;
    :koreanLabel "항염증 사이토카인" ;
    rdfs:subClassOf :Cytokine .

:CompositeEnvironmentalIndex a owl:Class ;
    rdfs:label "Composite Environmental Index" ;
    obo:IAO_0000115 "A derived index combining multiple environmental measurements into a single immune-relevant score." ;
    :koreanLabel "복합환경지표" .

:DiseaseTrajectory a owl:Class ;
    rdfs:label "Disease Trajectory" ;
    obo:IAO_0000115 "A temporal model of immune system state changes connecting environmental exposure and immune response over time to predict disease onset, aggravation, and treatment pathways. The 'health compass' showing where immunity stands and where it is heading." ;
    :koreanLabel "질병 궤적" ;
    rdfs:subClassOf obo:BFO_0000015 .

:IL6 a owl:Class ;
    rdfs:label "Interleukin-6" ;
    obo:IAO_0000115 "Pro-inflammatory cytokine. PM2.5 exposure → NF-κB activation → IL-6 transcription. Key marker linking environment to systemic inflammation." ;
    :koreanLabel "인터류킨-6" ;
    rdfs:subClassOf :ProInflammatoryCytokine .

:ReactiveOxygenSpecies a owl:Class ;
    rdfs:label "Reactive Oxygen Species" ;
    :koreanLabel "활성산소종" ;
    rdfs:subClassOf :ReactiveSpecies .

:ReactiveSpecies a owl:Class ;
    rdfs:label "Reactive Species" ;
    obo:IAO_0000115 "Reactive oxygen and nitrogen species (RONS) generated by cold atmospheric plasma or biological processes." ;
    :koreanLabel "활성종" ;
    rdfs:subClassOf obo:BFO_0000004 .

:TNFAlpha a owl:Class ;
    rdfs:label "TNF-alpha" ;
    obo:IAO_0000115 "Pro-inflammatory cytokine released by M1-polarized alveolar macrophages. Linked to psoriasis via Th17/TNF-α axis." ;
    :koreanLabel "종양괴사인자-알파" ;
    rdfs:subClassOf :ProInflammatoryCytokine .

obo:BFO_0000004 a owl:Class ;
    rdfs:label "independent continuant" .

obo:BFO_0000015 a owl:Class ;
    rdfs:label "process" .

:Biomarker a owl:Class ;
    rdfs:label "Biomarker" ;
    obo:IAO_0000115 "A measurable biological indicator of immune system state or disease trajectory." ;
    :koreanLabel "바이오마커" ;
    rdfs:subClassOf obo:BFO_0000020 .

:NFkBPathway a owl:Class ;
    rdfs:label "NF-κB Pathway" ;
    obo:IAO_0000115 "Central inflammatory signaling cascade. H2O2 → IKK activation → IκB degradation → NF-κB nuclear translocation → pro-inflammatory cytokine transcription." ;
    :koreanLabel "NF-κB 경로" ;
    rdfs:subClassOf :SignalingPathway .

:ProInflammatoryCytokine a owl:Class ;
    rdfs:label "Pro-inflammatory Cytokine" ;
    :koreanLabel "염증성 사이토카인" ;
    rdfs:subClassOf :Cytokine .

:VolatileOrganicCompound a owl:Class ;
    rdfs:label "Volatile Organic Compound" ;
    obo:IAO_0000115 "VOCs including BTEX compounds that disrupt epithelial barriers and skew Th2 immune response." ;
    :koreanLabel "휘발성유기화합물" ;
    rdfs:subClassOf :AirPollutant .

:LifelogObservation a owl:Class ;
    rdfs:label "Lifelog Observation" ;
    obo:IAO_0000115 "A biosignal measurement captured from a wearable device or personal health sensor." ;
    :koreanLabel "라이프로그 관측" ;
    rdfs:subClassOf obo:BFO_0000015 .

:PM2_5 a owl:Class ;
    rdfs:label "PM2.5" ;
    obo:IAO_0000115 "Fine particulate matter with aerodynamic diameter ≤ 2.5 μm. Primary environmental trigger for immune inflammation via ROS→NF-κB→IL-6 pathway." ;
    :koreanLabel "초미세먼지" ;
    rdfs:subClassOf :ParticulateMatter .

:SignalingPathway a owl:Class ;
    rdfs:label "Signaling Pathway" ;
    obo:IAO_0000115 "A molecular signaling cascade that mediates immune response." ;
    :koreanLabel "신호전달 경로" ;
    rdfs:subClassOf obo:BFO_0000015 .

:EnvironmentalFactor a owl:Class ;
    rdfs:label "Environmental Factor" ;
    obo:IAO_0000115 "An environmental agent or condition that may affect immune system function." ;
    :koreanLabel "환경 요인" ;
    rdfs:subClassOf obo:BFO_0000004 .

:ImmuneDisease a owl:Class ;
    rdfs:label "Immune Disease" ;
    obo:IAO_0000115 "A disease of the immune system. Corresponds to DO DOID:2914 subtree." ;
    :koreanLabel "면역 질환" ;
    rdfs:subClassOf obo:BFO_0000016,
        obo:DOID_2914 .

:TrajectoryStage a owl:Class ;
    rdfs:label "Trajectory Stage" ;
    obo:IAO_0000115 "A discrete stage within a disease trajectory representing a specific immune state." ;
    :koreanLabel "궤적 단계" ;
    rdfs:subClassOf :DiseaseTrajectory .

:CausalPathway a owl:Class ;
    rdfs:label "Causal Pathway" ;
    obo:IAO_0000115 "A chain of cause-and-effect relationships linking environmental exposure through biological mechanisms to disease outcomes, queryable via SPARQL." ;
    :koreanLabel "인과 경로" .

